class Solution {
    public boolean canMakeArithmeticProgression(int[] nums) {

        Arrays.sort(nums);
        boolean flag = false;
        int firstDiff = 0;
        for(int i=0; i<nums.length-1; i++) {
            int diff = nums[i] - nums[i+1];

            if(!flag) {
                flag = true;
                firstDiff = diff;
            } else {
                if(firstDiff != diff)
                    return false;
            }
        }
        return true;
    }
}
