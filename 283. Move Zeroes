class Solution {
    private void display(int[] nums){
        for(int i:nums) 
            System.out.print(i+" ");
        System.out.println();
    }
    public void moveZeroes(int[] nums) {

        if(nums.length <= 1)
            return;

        //display(nums);

        for(int i=nums.length-1; i>=0 ; i--){
            //System.out.println(nums[i]);
            if(nums[i] == 0 && i != nums.length-1) {
                int j = i;
                for(; nums[i+1] != 0 && j<nums.length-1; j++) {
                    nums[j] = nums[j+1];
                }
                nums[j] = 0;
            }
            //display(nums);
        }
    }
}
