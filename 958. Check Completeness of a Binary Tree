/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public boolean isCompleteTree(TreeNode root) {
        List<TreeNode> list = new ArrayList<>();
        list.add(root);
        int len = 1;
        List<TreeNode> tlist = new ArrayList<>();
        while(!list.isEmpty()) {
            for(int i=0; i<list.size(); i++) {
                TreeNode node = list.get(i);
                if(node.left != null)
                    tlist.add(node.left);
                if(node.right != null) {
                    if(node.left == null)
                        return false;
                    else
                        tlist.add(node.right);
                } else {
                    if(i+1 < list.size()) {
                        TreeNode tnode = list.get(i+1);
                        if(tnode.left != null || tnode.right != null)
                            return false;
                    }
                }
            }
            if(list.size() < len && tlist.size() > 0) 
                return false;
            
            len *= 2;
            list.clear();
            list.addAll(tlist);
            tlist.clear();
        }

        return true;
    }
}
