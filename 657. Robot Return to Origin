class Solution {
    public boolean judgeCircle(String moves) {
        int u=0, l=0;
        for(char c:moves.toCharArray()) {
            switch(c) {
                case 'U': u++; break;
                case 'D': u--; break;
                case 'L': l++; break;
                case 'R': l--; break;
            }
        }
        return (u == 0 && l==0) ? true : false;
    }
}
