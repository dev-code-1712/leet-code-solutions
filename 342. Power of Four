class Solution {
    public boolean isPowerOfFour(int n) {
         if(n < 1)
            return false;
        if(n == 1)
            return true;
        else if (n == 2)
            return false;
        long pw = 1;
        while(pw < n)
            pw = pw*4;
        return pw==n?true:false;
    }
}
