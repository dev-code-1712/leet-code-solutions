class Solution {
    public List<Integer> toggleLightBulbs(List<Integer> bulbs) {
       List<Integer> list = new ArrayList();
       int[] numbers = new int[100];
       for(int bulb : bulbs) {
            numbers[bulb - 1] ^= 1; 
       }

       for(int i=0; i<100; i++) {
            if(numbers[i] == 1)
                list.add(i+1);
       }

       return list;
    }
}
