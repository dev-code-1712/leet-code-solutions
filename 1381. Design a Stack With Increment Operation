class CustomStack {
    int[] stack = null;
    int pos = -1, max = -1;
    public CustomStack(int maxSize) {
        stack = new int[maxSize];
        pos = -1;
        max = maxSize;
    }
    
    public void push(int x) {
        if(pos + 1 < max)
            stack[++pos] = x;

    }
    
    public int pop() {
        int val = -1;
        if(pos >= 0)
            val = stack[pos--];

        return val;
    }
    
    public void increment(int k, int val) {
        for(int i=0; i<=Math.min(k-1,pos); i++) 
            stack[i] += val;
        
    }
}

