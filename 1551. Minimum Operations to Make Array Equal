class Solution {
    public int minOperations(int n) {
        int[] arr = new int[n];
        int sum = 0;
        for(int i=0; i<n; i++) {
            arr[i] = 2*i + 1;
        }
        int x = 1;
        for(int i=n/2; i > 0; i--) {
            int low = i-1;
            int high = low + (n%2 == 1? 2*x : 2*x - 1);
            int val = (arr[low] + arr[high])/2;
            int diff = arr[high] - val;
            arr[high] = arr[i] - diff;
            arr[low] = arr[i-1] + diff;
            sum += diff;
            x += 1;
        }

        return sum;
    }
}
