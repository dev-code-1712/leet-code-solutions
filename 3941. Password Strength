class Solution {
    public int passwordStrength(String password) {
        Set<Character> set = new HashSet();
        for(int i=0; i<password.length(); i++) {
            set.add(password.charAt(i));
        }

        int sum = 0;
        for(char ch : set) {
            if(ch >= 'a' && ch <='z')
                sum += 1;
            else if(ch >= 'A' && ch <='Z')
                sum += 2;
            else if(ch >= '0' && ch <='9')
                sum += 3;
            else if(ch == '!' || ch =='@' || ch =='#' || ch =='$')
                sum += 5;
        }

        return sum;
    }
}
