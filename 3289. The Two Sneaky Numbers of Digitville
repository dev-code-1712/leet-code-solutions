class Solution {
    public int[] getSneakyNumbers(int[] nums) {
        Set<Integer> set = new HashSet();
        int[] dups = new int[2];
        int i=0;
        for(int val : nums) {
            if(set.contains(val)) {
                dups[i++] = val;
            } else {
                set.add(val);
            }
        }
        return dups;
    }
}
