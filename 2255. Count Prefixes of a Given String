class Solution {
    public int countPrefixes(String[] words, String s) {
        Set<String> set = new HashSet();
        for(int i=1; i<=s.length(); i++) {
            set.add(s.substring(0, i));
        }

        int count = 0;
        for(String str:words) {
            if(set.contains(str))
                count ++;
        }

        return count;
    }
}
