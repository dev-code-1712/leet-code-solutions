class Solution {
    public int[] sortArrayByParity(int[] nums) {
        int[] result = new int[nums.length];
        int s=0, e=nums.length-1;
        for(int i=0; i<nums.length; i++) {
            if(nums[i] % 2 == 0)
                result[s++] = nums[i];
            else
                result[e--] = nums[i];
        }

        return result;
    }
}
