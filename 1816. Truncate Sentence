class Solution {
    public String truncateSentence(String s, int k) {
        StringBuilder result = new StringBuilder();
        String[] vals = s.split(" ");
        for(int i=0; i<k && i<vals.length; i++) {
            if(i>0)
                result.append(" ");
            result.append(vals[i]);
        }
        return result.toString();
    }
}
