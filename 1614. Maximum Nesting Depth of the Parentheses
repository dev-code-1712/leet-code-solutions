class Solution {
    public int maxDepth(String s) {
        int max = 0, left = 0;
        for(int i=0; i<s.length(); i++) {
            if(s.charAt(i) == '(') {
                left++;
                if(max < left)
                    max = left;
            } else if(s.charAt(i) == ')') {
                left --;
            }
        }
        return max;
    }
}
