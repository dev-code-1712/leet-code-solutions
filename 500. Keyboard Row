class Solution {
    public String[] findWords(String[] words) {
        List<String> list = new ArrayList<String>();

        String row1 = "qwertyuiop";
        String row2 = "asdfghjkl";
        String row3 = "zxcvbnm";

        for(String str:words) {
            String krow = "";
            char[] vals = str.toCharArray();
            char c = vals[0];
            if(c >='A' && c<='Z')
                c = (char)(c+32);
            
            if(row1.indexOf(c) != -1)
                krow = row1;
            else if(row2.indexOf(c) != -1)
                krow = row2;
            else if(row3.indexOf(c) != -1)
                krow = row3;
            
            int i=1; 
            while(i<str.length()) {
                c = vals[i];
                if(c >='A' && c<='Z')
                    c = (char)(c+32);
                
                if(krow.indexOf(c) == -1)
                    break;

                i++;
            }
            if(i == str.length())
            	list.add(str);
        }
        String[] result = new String[list.size()];
        int pos = 0;
        for(String str:list)
            result[pos++] = str;

        return result;
    }
}
