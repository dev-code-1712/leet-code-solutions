class Solution {
    public String digitSum(String s, int k) {
        StringBuilder builder = new StringBuilder();
        while(s.length() > k) {
            for(int i=0; i<s.length(); i+=k) {
                int sum = 0;
                for(int j=0; j<k; j++) {
                    if(i+j < s.length())
                        sum += s.charAt(i+j) - '0';
                }
                builder.append(sum); 
            }
            s = builder.toString();
            builder.setLength(0);
        }
        return s;
    }
}
