class Solution {
    public int countEven(int num) {
        int count = 0;
        for(int i=1; i<=num; i++) {
            String str = i+"";
            int sum = 0;
            for(int j=0; j < str.length(); j++) {
                sum += str.charAt(j) - '0';
            }
            if(sum % 2 == 0)
                count ++;
        }

        return count;
    }
}
