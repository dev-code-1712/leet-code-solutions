class Solution {
    Set<Character> makeset(String str) {
        Set<Character> set = new HashSet();
        for(int i=0; i<str.length(); i++)
            set.add(str.charAt(i));

        return set;
    }
    public int countConsistentStrings(String allowed, String[] words) {
        int count = 0;
        Set<Character> as = makeset(allowed);
        for(String word : words) {
            Set<Character> ws = makeset(word);
            //System.out.println(allowed +" --- "+ws);
            if(as.containsAll(ws))
                count ++;
        }
        return count;
    }
}
