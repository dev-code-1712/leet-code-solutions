class Solution {
    public boolean checkValid(int[][] matrix) {
        int n = matrix.length;
        Set<Integer> set = new HashSet<>();
        Set<Integer> set2 = new HashSet<>();
        for(int i=0; i<n; i++) {
            for(int j=0; j<n; j++) {
                set.add(matrix[i][j]);
                set2.add(matrix[j][i]);
            }
            
            if(set.size() != n || set2.size() != n)
                return false;
            
            set.clear();
            set2.clear();
        }

        return true;  
    }
}
