class Solution {
    public int busyStudent(int[] startTime, int[] endTime, int queryTime) {
        int count = 0;
        for(int i=0; i<startTime.length; i++) {
            int worktime = endTime[i] - startTime[i];
            if(queryTime >= startTime[i] && queryTime <= startTime[i]+worktime)
                count ++;
        }
        return count;
    }
}
