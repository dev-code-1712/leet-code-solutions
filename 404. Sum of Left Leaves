/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public int sumOfLeftLeaves(TreeNode root) {
        if(root.left == null && root.right == null)
            return 0;

        return sumleftleaves(root, false);
    }

    public int sumleftleaves(TreeNode tree, boolean flag) {
        if(tree == null)
            return 0;
        if(tree.left == null && tree.right == null) {
            if(flag)
                return tree.val;
            else
                return 0;
        }

        return sumleftleaves(tree.left, true) + 
                sumleftleaves(tree.right, false);
    }
}
