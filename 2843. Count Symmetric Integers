class Solution {
    int getPartSum(String part) {
        int sum = 0;
        for(int i=0; i<part.length(); i++) 
            sum += part.charAt(i) - '0';
        
        return sum;
    }
    public int countSymmetricIntegers(int low, int high) {
        int count = 0;
        for(int i=low; i<=high; i++) {
            String str = ""+i;
            if(str.length() % 2 == 1)
                continue;
            
            String part1 = str.substring(0, str.length()/2);
            String part2 = str.substring(str.length()/2);

            int sum1 = getPartSum(part1);
            int sum2 = getPartSum(part2);
            
            if(sum1 == sum2)
                count ++;
        }

        return count;
    }
}
