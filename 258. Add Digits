class Solution {
    public int addDigits(int num) {
        if(num < 10)
            return num;
        
        while(num > 9) {
            int sum = 0;
            String str = String.valueOf(num);

            for(char c: str.toCharArray()) {
                sum+= (c-48);
            }
            num = sum;
        }

        return num;
    }
}
