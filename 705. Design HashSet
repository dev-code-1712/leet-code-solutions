class MyHashSet {
    List<Integer> list = null;
    public MyHashSet() {
        list = new ArrayList<>();
    }
    
    public void add(int key) {
        if(!contains(key))
            list.add(key);
    }
    
    public void remove(int key) {
        int pos = list.indexOf(key);
        if(pos != -1)
            list.remove(pos);
    }
    
    public boolean contains(int key) {
        return list.contains(key);
    }
}

