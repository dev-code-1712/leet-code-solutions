class Solution {
    public boolean isStrictlyPalindromic(int n) {
        for(int i=2; i<= n-2; i++) {
            String str = convertBaseB(n, i);
            //System.out.println(i+" "+str);
            if(!str.equals(new StringBuilder(str).reverse().toString()))
                return false;
        }
        return true;
    }

    String convertBaseB(int n, int b) {
        if(n < b)
            return ""+n;
        
        return convertBaseB(n/b, b) + ""+(n % b);

    }
}
