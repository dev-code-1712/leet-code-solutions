class Solution {
    public String addStrings(String num1, String num2) {
        int len = num1.length();
        int len2 = num2.length();
        String result = "";
        int carry = 0, x,y, sum=0;
        while(len > 0 && len2 > 0) {
            x = Integer.valueOf(num1.substring(len-1, len));
            y = Integer.valueOf(num2.substring(len2-1, len2));
            sum = carry + x + y;
            if(sum >= 10) {
                result = String.valueOf(sum % 10) + result;
                carry = 1;
            } else {
                result = String.valueOf(sum) + result;
                carry = 0;
            }
            len --;
            len2 --;
        }
        // System.out.println("len: "+len+", len2: "+len2);
        // System.out.println(result);

        while(len > 0) {
            x = Integer.valueOf(num1.substring(len-1, len));
            sum = carry + x;

            if(sum >= 10) {
                result = String.valueOf(sum % 10) + result;
                carry = 1;
            } else {
                result = String.valueOf(sum) + result;
                carry = 0;
            }

            len --;
        }

        while(len2 > 0) {
            y = Integer.valueOf(num2.substring(len2-1, len2));
            sum = carry + y;

            if(sum >= 10) {
                result = String.valueOf(sum % 10) + result;
                carry = 1;
            } else {
                result = String.valueOf(sum) + result;
                carry = 0;
            }
            
            len2 --;
        }
        if(carry == 1)
            result = String.valueOf(1) + result;
        //System.out.println(result);
        return result;
    }
}
