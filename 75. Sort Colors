class Solution {
    public void sortColors(int[] nums) {
        for(int i=1; i<nums.length; i++) {
            for(int j=i; j>0; j--) {
                if(nums[j-1] > nums[j]) {
                    int t = nums[j];
                    nums[j] = nums[j-1];
                    nums[j-1] = t;
                }
            }
        }
    }
}
