class Solution {
    public int[] getMaximumXor(int[] nums, int maximumBit) {
        int max = (int) Math.pow(2, maximumBit) - 1;
        int len = nums.length;
        int[] result = new int[len];

        int val = nums[0];
        for(int i=0; i<len; i++) {
            if(i > 0)
                val ^= nums[i];

            result[len-i-1] = val ^ max;
        }

        return result;
    }
}
