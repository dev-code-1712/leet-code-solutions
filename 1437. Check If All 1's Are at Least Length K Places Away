class Solution {
    public boolean kLengthApart(int[] nums, int k) {
        if(nums.length <= 1 || k == 0)
            return true;
        
        int i=0; 
        while(i<nums.length) {
            if(nums[i] == 1) {
                int zeros = 0;
                for(int j=i+1; j < nums.length && nums[j] == 0; j++, zeros ++);
                
                i += zeros;
                if(i < nums.length-1 && zeros < k) {
                    return false;
                } 
            } 
            i++;
        }

        return true;
    }
}
