class Solution {
    public boolean canConstruct(String ransomNote, String magazine) {
        if(magazine.contains(ransomNote))
            return true;

        Map<Character, Integer> ransom = findMap(ransomNote);
        Map<Character, Integer> mag = findMap(magazine);

        // System.out.println(ransom);
        // System.out.println(mag);

        for(char key:ransom.keySet()) {
            if(!mag.containsKey(key) || mag.get(key) < ransom.get(key))
                return false;
        }
        return true;
    }

    private Map<Character, Integer> findMap(String str) {
        Map<Character, Integer> map = new HashMap<>();
        for(char c : str.toCharArray()) {
            if(map.containsKey(c)) {
                int val = map.get(c);
                map.put(c, val+1);
            } else {
                map.put(c, 1);
            }
        }
        return map;
    }
}
