class Solution {
    public double average(int[] salary) {
        int min = salary[0], max = 0;
        double total = 0;
        for(int sal:salary) {
            if(sal < min) 
                min = sal;
            
            if(sal > max)
                max = sal;
            
            total += sal;
        }
        total = total - min - max;
        return total / (salary.length - 2);
    }
}
