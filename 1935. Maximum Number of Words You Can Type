class Solution {
    public int canBeTypedWords(String text, String brokenLetters) {
        char[] vals = brokenLetters.toCharArray();
        int count = 0;
        for(String str : text.split(" ")) {
            boolean flag = true;
            for(char c:vals) {
                if(str.indexOf(c) != -1) {
                    flag = false;
                    break;
                }
            }
            if(flag)
                count ++;
        }
        return count;
    }
}
