class Solution {
    public int[] decompressRLElist(int[] nums) {
        List<Integer> list = new ArrayList();
        for(int i=0; i<nums.length; i+=2) {
            for(int j=1; j<=nums[i]; j++)
                list.add(nums[i+1]);
        }
        int[] result = new int[list.size()];
        int i=0;
        for(int num: list)
            result[i++] = num;
        return result;
    }
}
