class Solution {
    public String stringHash(String s, int k) {
        String result = "";
        int len = s.length();

        for(int i=0; i < len; i+=k) {
            String str = s.substring(i, i+k);
            int sum = 0;
            for(int j=0; j<k; j++) {
                sum += s.charAt(i+j) - 'a';
            }
            sum = sum % 26;
            result += (char)(sum + 97);
        }

        return result;
    }
}
