class Solution {
    public int numDifferentIntegers(String word) {
        Set<String> set = new HashSet<>();
        int start = 0, end = 0;
        for(int i=0; i<word.length(); i++) {
            if(word.charAt(i) >= '0' && word.charAt(i) <= '9') {
                start = i;
                end = i;
                int j=i+1; 

                while(j<word.length()) {
                    if(word.charAt(j) >= 'a' && word.charAt(j) <= 'z') {
                        end = j-1;
                        break;
                    }
                    j++;
                }
                if(j == word.length()) {
                    end = j-1;
                }
                i=end;
                String str = word.substring(start, end+1);

                int ii=0;
                while(ii < str.length() && str.charAt(ii) == '0')
                    ii++;
                
                if(ii > 0) {
                    if(ii == str.length())
                        str = "0";
                    else
                        str = str.substring(ii);
                } 

                if(str.length() > 0)
                    set.add(str);
            }
        }

        return set.size();
    }
}
