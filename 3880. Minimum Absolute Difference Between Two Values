class Solution {
    public int minAbsoluteDifference(int[] nums) {
        int min = 100;
        for(int i=0; i<nums.length-1; i++) {
            for(int j=i+1; j<nums.length; j++) {
                if( (nums[i] == 1 && nums[j] == 2) ||
                    (nums[i] == 2 && nums[j] == 1)) {
                    int abs = Math.abs(i-j);
                    if(min > abs)
                        min = abs;
                }
            }
        }
        return min != 100 ? min : -1;
    }
}
