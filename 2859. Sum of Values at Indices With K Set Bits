class Solution {
    public int sumIndicesWithKSetBits(List<Integer> nums, int k) {
        int sum = 0;
        for(int i=0; i<nums.size(); i++) {
            int count = 0, val = i;
            while(val > 0) {
                if(val % 2 == 1)
                    count ++;
                
                val /= 2;
            }
            if(count == k)
                sum += nums.get(i);
        }

        return sum;
    }
}
