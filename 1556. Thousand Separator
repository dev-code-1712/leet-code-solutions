class Solution {
    public String thousandSeparator(int n) {
        String result = "";
        if(n == 0)
            return "0";
        int counter = 0;
        while(n > 0) {
            if(counter == 3) {
                result = (n%10) + "."+result;
                counter = 0;
            } else {
                result = (n%10) + result;
            }
            counter ++;
            n/=10;
        }
        return result;
    }
}
