class Solution {
    public int countDigitOccurrences(int[] nums, int digit) {
        int count = 0 ;
        for(int i=0; i<nums.length; i++) {
            int val = nums[i];
            while(val > 0) {
                if(val % 10 == digit)
                    count++;
                val = val / 10;
            }
        }

        return count;
    }
}
