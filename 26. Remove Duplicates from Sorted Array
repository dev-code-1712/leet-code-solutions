class Solution {
    public int removeDuplicates(int[] nums) {
                int count = 1;
        if(nums.length <= 1)
            return nums.length;
        int dups = 0;
        for(int i=0; i<nums.length-1-dups;) {
            if(nums[i] == nums[i+1]) {
                dups++;
                for(int j=i; j<nums.length-dups; j++) {
                    nums[j] = nums[j+1];
                }

            } else {
            	i++;
                count++;
            }
        }
        return count;
    }

}
