class Solution {
    public boolean threeFibonacciSum(int n) {
        int sum = 0, x=0, y=1, z=1;
        do {
            sum = x + y + z;
            if(sum == n)
                return true;
            
            int t1 = y;
            x = y;
            y = z;
            z = t1 + y;
            
        } while (sum <= n);

        return false;
    }
}
