class Solution {
    public int islandPerimeter(int[][] grid) {

        int rows = grid.length;
        int cols = grid[0].length;
        int perimeter = 0;

        for(int i=0; i<rows; i++) {
            for(int j=0; j<cols; j++) {
                if(grid[i][j] == 1) {
                	//System.out.print("i: "+i+", j: "+j);
                	
                    if(i == 0)
                        perimeter ++;
                   
                    if(i == rows - 1)
                    	perimeter ++;
                    
                    if(j == 0)
                        perimeter ++;
                    
                    if(j == cols - 1)
                    	perimeter ++;
                    
                    if(i-1 >=0 && i <= rows-1 && grid[i-1][j] == 0)
                        perimeter ++;
                    
                    if(i-1 >= -1 && i <= rows-1 && i+1 < rows && grid[i+1][j] == 0)
                        perimeter ++;
                   
                    if(j-1 >= 0 && j <= cols-1 && grid[i][j-1] == 0)
                        perimeter ++;

                    if(j-1 >= -1 && j <= cols-1 && j+1 < cols && grid[i][j+1] == 0)
                        perimeter ++;
                    
                    //System.out.println(", perimeter: "+ perimeter);
                }
            }
        }

        return perimeter;
    }
}
