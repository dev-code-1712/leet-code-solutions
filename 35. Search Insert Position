class Solution {
    public int searchInsert(int[] nums, int target) {
        int mid = -1;
        int low=0, high=nums.length-1;
        if(target <= nums[0])
            return 0;
        
        if (target > nums[nums.length-1])
            return nums.length;

        while(low < high) {
        	mid = (low + high) / 2;
            if(target == nums[mid])
            	return mid;
            else if(target < nums[mid])
                high = mid-1;
            else
                low = mid+1;
        }

        if(low == high) {
        	if(nums[low] < target)
        			return low+1;
        	else
        			return low;
        }
        return mid;
    }
}
