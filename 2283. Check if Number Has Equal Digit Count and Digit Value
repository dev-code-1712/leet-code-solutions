class Solution {
    public boolean digitCount(String num) {
        int[] digits = new int[10];
        for(int i=0; i<num.length(); i++) {
            int d = num.charAt(i) - '0';
            digits[d] ++;
        }
        
        String str = "";
        for(int i=0; i<num.length(); i++) {
            str += digits[i];
        }

        return num.equals(str);
    }
}
