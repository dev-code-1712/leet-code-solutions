class Solution {
    public boolean rotateString(String s, String goal) {

        if(s.equals(goal))
            return true;

        if(s.length() != goal.length())
            return false;

        String ss = s;
        for(int i=0; i<s.length(); i++) {
        	ss = ss.substring(1, s.length()) + ss.substring(0, 1);
        	
        	if(ss.equals(goal))
        		return true;
        }
        
        return false;
    }
}
