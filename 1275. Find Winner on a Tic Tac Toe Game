class Solution {
    public String tictactoe(int[][] moves) {
        char[][] grid = new char[3][3];
        for(int i=0; i<moves.length; i++) {
            int row = moves[i][0];
            int col = moves[i][1];
            if(i % 2 == 0)
                grid[row][col] = 'X';
            else
                grid[row][col] = 'O';
        }
        int spaces = 0;
        String winner = "";
        for(int i=0; i<3; i++) {
            char firstPlayer = '\0';
            boolean flag = false;
            int count = 0;
            for(int j=0; j<3; j++) {
                if(grid[i][j] == '\0') {
                    spaces++;
                    break;
                } else {
                	if(!flag) {
                        firstPlayer = grid[i][j];
                        flag = true;
                        count++;
                    } else {
                        if(firstPlayer == grid[i][j])
                            count++;
                    }
                }
                
            }
            if(count == 3) {
                if(firstPlayer == 'X')
                	winner = "A";
                else
                	winner = "B";
            }
        }
        if(winner == "") {
        	for(int i=0; i<3; i++) {
                char firstPlayer = '\0';
                boolean flag = false;
                int count = 0;
                for(int j=0; j<3; j++) {
                    if(grid[j][i] == '\0') {
                        break;
                    } else {
                    	if(!flag) {
                            firstPlayer = grid[j][i];
                            flag = true;
                            count++;
                        } else {
                            if(firstPlayer == grid[j][i])
                                count++;
                        }
                    }
                    
                    
                }
                if(count == 3) {
                    if(firstPlayer == 'X')
                    	winner = "A";
                    else
                    	winner = "B";
                }
            }
        }
        
        if(winner == "") {
        	if(grid[0][0] != '\0' && grid[0][0] == grid[1][1] && grid[1][1] == grid[2][2]) {
        		if(grid[0][0] == 'X')
                	winner = "A";
                else
                	winner = "B";
        	}
        	
        	if(grid[0][2] != '\0' && grid[0][2] == grid[1][1] && grid[1][1] == grid[2][0]) {
        		if(grid[0][2] == 'X')
                	winner = "A";
                else
                	winner = "B";
        	}
        	
        }
        
        if(winner != "")
        	return winner;
        
        if(spaces == 0)
        	return "Draw";
        
		return "Pending";
    }
}
