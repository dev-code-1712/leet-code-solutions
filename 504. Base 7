class Solution {
    public String convertToBase7(int num) {
        if(num == 0)
            return "0";

        String result = "";
        long temp = num < 0 ? -num : num;
        while(temp > 0) {
            result = (temp % 7) + result;
            temp = temp / 7;
        }

        if(num < 0)
            result =  "-" + result;

        //System.out.println(result);

        return result;
    }
}
