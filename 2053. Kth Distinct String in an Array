class Solution {
    public String kthDistinct(String[] arr, int k) {
        Map<String, Integer> map = new LinkedHashMap();
        for(String str:arr) {
            if(map.containsKey(str))
                map.put(str, map.get(str)+1);
            else
                map.put(str, 1);
        }

        int count = 1;
        for(String str:map.keySet()) {
            if(map.get(str) == 1) {
                if(count == k)
                    return str;
                
                count ++;
            }
                
        }

        return "";
    }
}
