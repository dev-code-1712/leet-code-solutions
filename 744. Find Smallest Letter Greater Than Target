class Solution {
    public char nextGreatestLetter(char[] letters, char target) {
        boolean flag = false;
        char small = '\0';
        for(int i=0; i<letters.length; i++) {
            if(target < letters[i]) {
                if(!flag) {
                    small = letters[i];
                    flag = true;
                } else {
                    if(small > letters[i])
                        small = letters[i];
                }
            }
        }

        return flag ? small : letters[0];
    }
}
