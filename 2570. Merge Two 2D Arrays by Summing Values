class Solution {
    void numbermap(int[][] nums, Map<Integer, Integer> map) {
        for(int i=0; i<nums.length; i++) {
            int loc = nums[i][0];
            int val = nums[i][1];

            if(map.containsKey(loc)) 
                map.put(loc, map.get(loc) + val);
            else 
                map.put(loc, val);
        }
    }

    public int[][] mergeArrays(int[][] nums1, int[][] nums2) {
        Map<Integer, Integer> map = new HashMap();
        numbermap(nums1, map);
        numbermap(nums2, map);
        int[][] result = new int[map.size()][2];
        Set<Integer> set = new TreeSet(map.keySet());

        int i=0;
        for(int num:set) {
            result[i][0] = num;
            result[i][1] = map.get(num);
            i++; 
        }
        return result;
    }
}
