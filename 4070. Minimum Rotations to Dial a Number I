class Solution {
    public int minRotations(String s) {
        int sum = 0;
        if(s.charAt(0) != '0') {
            int d = s.charAt(0) - '0';
            sum += Math.min(d, 10-d);
        }
        
        for(int i=0; i<s.length()-1; i++) {
            int d = s.charAt(i) - '0';
            int d2 = s.charAt(i+1) - '0';
            int diff = Math.abs(d-d2);
            int min = Math.min(diff, 10-diff);

            sum += min;
        }
        
        return sum;
    }
}
