/**
 * Definition for singly-linked list.
 * public class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode() {}
 *     ListNode(int val) { this.val = val; }
 *     ListNode(int val, ListNode next) { this.val = val; this.next = next; }
 * }
 */
class Solution {
    public ListNode mergeNodes(ListNode head) {
        ListNode temp = head;
        ListNode mhead = null, mtail = null;
        while(temp != null) {
            if(temp.val != 0) {
                int sum = 0;
                ListNode temp2 = temp;
                while(temp2.val != 0) {
                    sum += temp2.val;
                    temp2 = temp2.next;
                }
                ListNode temp3 = new ListNode(sum);
                if(mhead == null){
                    mhead = mtail = temp3;
                } else {
                    mtail.next = temp3;
                    mtail = temp3;
                }
                temp = temp2;
            } else
                temp = temp.next;
        }
        return mhead;
    }
}
