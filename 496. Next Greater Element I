class Solution {
    public int[] nextGreaterElement(int[] nums1, int[] nums2) {

        List<Integer> list2 = new ArrayList();
        for(int i:nums2)
            list2.add(i);

        int[] result = new int[nums1.length];
        int i=0;
        for(int n: nums1) {
            int pos = list2.indexOf(n);
            //System.out.println(pos);
            int max = -1;
            if(pos != -1){
                for(int k=pos; k<list2.size(); k++) {
                    if(n < list2.get(k)) {
                        max = list2.get(k);
                        break;
                    }
                }
            }

            result[i++] = max;
            //System.out.println(max);
        }
        return result;
    }
}
