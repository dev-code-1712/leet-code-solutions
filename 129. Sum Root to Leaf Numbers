/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    
    void findLeafNumbers(TreeNode node, List<String> list, String str) {
        if(node == null)
            return;
            
        if(node.left == null && node.right == null) {
            list.add(str + node.val);
            return;
        }
        findLeafNumbers(node.left, list, str + node.val);
        findLeafNumbers(node.right, list, str + node.val);
    }


    public int sumNumbers(TreeNode root) {
        List<String> list = new ArrayList();
        findLeafNumbers(root, list, "");
        System.out.println(list);

        int sum = 0;
        for(String str:list) {
            sum += Integer.valueOf(str);
        }
        return sum;
    }
}
