class Solution {
    public boolean repeatedSubstringPattern(String s) {
        String str = "";
        for(int i=0; i<s.length()-1; i++) {
            str = s.substring(0, i+1);
            if(s.length() % str.length() != 0)
                continue;
            
            String temp = "";
            for(int j=1; j<= (s.length() / str.length()); j++)
                temp = temp + str;
            //System.out.println(str +" -- "+temp);
            if(temp.equals(s))
                return true;
        }

        return false;
    }
}
