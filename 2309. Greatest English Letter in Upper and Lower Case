class Solution {
    public String greatestLetter(String s) {
        int[] lower = new int[26];
        int[] greater = new int[26];

        for(int i=0; i<s.length(); i++) {
            char ch = s.charAt(i);
            if(ch >='A' && ch <='Z')
                greater[ch-'A'] ++;
            else if(ch >='a' && ch <='z')
                lower[ch-'a'] ++;
        }

        for(int i=25; i >=0; i--) {
            if(lower[i] > 0 && greater[i] > 0)
                return ""+(char)(i+'A');
        }

        return "";
    }
}
