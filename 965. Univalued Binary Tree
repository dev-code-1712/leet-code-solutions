/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public boolean isUnivalTree(TreeNode root) {
        Set<Integer> set = new HashSet();
        findSet(root, set);
        return set.size() <= 1 ? true : false;
    }

    void findSet(TreeNode node, Set<Integer> set) {
        if(node == null)
            return;
            
        set.add(node.val);
        findSet(node.left, set);
        findSet(node.right, set);
    }
}
