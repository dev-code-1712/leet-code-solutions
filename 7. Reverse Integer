class Solution {
    public int reverse(int x) {
        int temp = (x < 0)? -x : x;

        long result = 0;
        while(temp > 0) {
            result = result * 10 + temp % 10;
            temp = temp / 10;
        }
        
        //System.out.println(result);

        if(result < Integer.MIN_VALUE  || result > Integer.MAX_VALUE)
            result = 0;
        //System.out.println(result);
        
        return (int) (x<0 ? -result : result);

    }
}
