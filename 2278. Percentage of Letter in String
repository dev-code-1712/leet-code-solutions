class Solution {
    public int percentageLetter(String s, char letter) {
        int[] letters = new int[26];
        int len = s.length();
        for(int i=0; i<len; i++) {
            letters[s.charAt(i) - 'a'] ++;
        }
        double p = (letters[letter - 'a']*1.0 / len) * 100;

        return ((int)p);
    }
}
