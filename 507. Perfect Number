class Solution {
    public boolean checkPerfectNumber(int num) {

        List<Integer> list = new ArrayList<>();
        int i=1;
        while(i < num) {
            if(num % i == 0)
                list.add(i);
            i++;
        }

        //System.out.println(list);

        int sum = 0;
        for(int x:list)
            sum += x;

        return num == sum ? true : false;
    }
}
