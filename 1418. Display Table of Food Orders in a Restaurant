class Solution {
    public List<List<String>> displayTable(List<List<String>> orders) {
        List<List<String>> result = new ArrayList();

        Set<String> header = new TreeSet();
        for(int i=0; i<orders.size(); i++) {
            header.add(orders.get(i).get(2));
        }
        
        List<String> fullheader = new ArrayList();
        fullheader.add("Table");
        fullheader.addAll(header);
        result.add(fullheader);

        Map<Integer, List<String>> map = new TreeMap();
        for(int i=0; i<orders.size(); i++) {
            int table = Integer.valueOf(orders.get(i).get(1));
            List<String> list = null;
            if(map.containsKey(table))
                list = map.get(table);
            else
                list = new ArrayList();
            
            list.add(orders.get(i).get(2));
            map.put(table, list);
        }

        List<String> list = new ArrayList();
        for(int table : map.keySet()) {
            for(int i=0; i<fullheader.size(); i++) {
                list.add("0");
            }

            list.set(0, ""+table);
            for(String item : map.get(table)) {
                int loc = fullheader.indexOf(item);
                if(list.get(loc) == null) {
                    list.set(loc, "1");
                } else {
                    list.set(loc, String.valueOf(Integer.valueOf(list.get(loc))+1) );
                }
            }
            result.add(list);
            list = new ArrayList();
        }
        return result;
    }
}
