class Solution {
    public int[] sortArrayByParityII(int[] nums) {
        int[] result = new int[nums.length];
        int s=0, e=1;
        for(int i=0; i<nums.length; i++) {
            if(nums[i] % 2 == 0) {
                result[s] = nums[i];
                s = s+2;
            } else {
                result[e] = nums[i];
                e = e+2;
            }
        }

        return result;
    }
}
