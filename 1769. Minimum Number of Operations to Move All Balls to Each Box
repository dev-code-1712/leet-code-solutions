class Solution {
    public int[] minOperations(String boxes) {
        int[] moves = new int[boxes.length()];
        for(int i=0; i<boxes.length(); i++) {
            int sum = 0;
            for(int j=0; j<boxes.length(); j++) {
                if(boxes.charAt(j) != '0') {
                    sum += Math.abs(i-j);
                }
            }
            moves[i] = sum;
        }

        return moves;
    }
}
