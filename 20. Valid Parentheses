class Solution {
    public boolean isValid(String s) {
        if(s.length() % 2 == 1) 
            return false;
        Stack stack = new Stack();
        int i=0;
        while(i<s.length()) {
            char ch = s.charAt(i);
            
            if( ch == '(' || ch == '[' || ch == '{') {
                stack.push(ch);
            }
            else if(ch == ')' && (stack.isEmpty() || (char)stack.pop() != '(')) {
                return false;
            } else if(ch == ']' && (stack.isEmpty() || (char)stack.pop() != '[')) {
                return false;
            } else if(ch == '}' && (stack.isEmpty() || (char)stack.pop() != '{')) {
                return false;
            }
            i++;
        }
        if(i == s.length() && stack.isEmpty())
            return true;
        else
            return false;
    }
}
