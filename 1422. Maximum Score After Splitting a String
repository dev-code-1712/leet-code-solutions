class Solution {
    public int maxScore(String s) {
        int zeros = 0, ones = 0, max = 0;
        for(char ch : s.toCharArray()) {
            if(ch == '1') {
                ones ++;
            }
        }
        char[] chars = s.toCharArray();
        for(int i=0; i<chars.length -1; i++) {
            char ch = chars[i];
            if(ch == '0') {
                zeros ++;
            } else if(ch == '1') {
                ones --;
            }

            int sum = zeros + ones;
            if(max < sum)
                max = sum;
        }
        return max;
    }
}
