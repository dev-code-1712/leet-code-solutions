class Solution {
    public int[] leftRightDifference(int[] nums) {
        int len = nums.length;
        int[] lsum = new int[len];
        int[] rsum = new int[len];

        for(int i=1; i<len; i++) {
            lsum[i] = nums[i-1] + lsum[i-1];
            rsum[len-i-1] = nums[len-i] + rsum[len-i];
        }
        for(int i=0; i<len; i++) {
            lsum[i] = Math.abs(lsum[i] - rsum[i]);
        }
        return lsum;
    }
}
