class Solution {
    public char repeatedCharacter(String s) {
        char letter = '\0';
        int min = 101;
        for(int i=0; i<s.length()-1; i++) {
            char ch = s.charAt(i);
            int loc = s.substring(i+1).indexOf(ch);

            if (loc != -1 && min > loc+i) {
                min = loc+i;
                letter = ch;
                
            }
            
        } 
        return letter;
    }
}
