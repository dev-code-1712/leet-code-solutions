class Solution {
    public int timeRequiredToBuy(int[] tickets, int k) {

        int time = 0, len = tickets.length;
        for(int i=0; ; i = (i+1) % len) {
            if(tickets[i] == 0)
                continue;
            time ++;
            tickets[i] --;
            if(i == k && tickets[i] == 0) 
                break;
        }
        return time;
    }
}
