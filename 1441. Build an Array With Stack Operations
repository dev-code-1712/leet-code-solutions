class Solution {
    public List<String> buildArray(int[] target, int n) {
        List<String> list = new ArrayList();
        int tloc = 0;
        for(int i=1;i<=n; i++) {
            if(tloc >= target.length)
                break;
                
            if(i == target[tloc]) {
                list.add("Push");
                tloc ++;
            } else if(i < target[tloc]) {
                list.add("Push");
                list.add("Pop");
            }
        }
        return list;
    }
}
