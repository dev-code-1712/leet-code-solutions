class Solution {
    public int[] numberOfLines(int[] widths, String s) {
        int lines = 0, pixels = 0, sum = 0;

        for(int i=0; i<s.length(); i++) {
            if(sum + widths[s.charAt(i) - 'a'] <= 100)
                sum += widths[s.charAt(i) - 'a'];
            else {

                lines ++;
                pixels = sum;
                sum = widths[s.charAt(i) - 'a'];
            }
        }
        
        lines ++;
        pixels = sum;
        return new int[] {lines, pixels};
    }
}
