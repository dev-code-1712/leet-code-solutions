class Solution {
    public int countDistinctIntegers(int[] nums) {
        Set<Integer> set = new HashSet();
        for(int i=0; i<nums.length; i++) {
            int temp = nums[i], sum = 0;
            while(temp > 0) {
                sum = sum*10 + temp % 10;
                temp /= 10;
            }
            set.add(nums[i]);
            set.add(sum);
        }

        return set.size();
    }
}
