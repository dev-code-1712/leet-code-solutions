class Solution {
    public boolean isMonotonic(int[] nums) {
        boolean flag = false;
        boolean isFirstInc = false, isFirstDec = false;
  
        for(int i=0; i<nums.length-1; i++) {
            int diff = nums[i] - nums[i+1];
            if(diff == 0)
                continue;
            
            if(!flag) {
                flag = true;
                if(diff < 0)
                    isFirstDec = true;
                else
                    isFirstInc = true;

            } else {
                if(diff < 0 && isFirstInc)
                    return false;
                
                if(diff > 0 && isFirstDec)
                    return false;
            }
            
        }
        return true;
    }
}
