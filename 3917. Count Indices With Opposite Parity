class Solution {
    public int[] countOppositeParity(int[] nums) {
        int[] result = new int[nums.length];

        for(int i=0; i<nums.length; i++) {
            boolean even = false, odd = false;
            int oc = 0, ec = 0;
            if(nums[i] % 2 == 0) 
                even = true;
            else
                odd = true;
            
            for(int j=i+1; j<nums.length; j++) {
                if(nums[j] % 2 == 1)
                    oc ++;
                else
                    ec ++;
            }

            if(even)
                result[i] = oc;
            else
                result[i] = ec;
            
        }

        return result; 
    }
}
