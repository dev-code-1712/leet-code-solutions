class Solution {
    public int maxLengthBetweenEqualCharacters(String s) {
        int max = -1;
        for(int i=0; i<s.length(); i++) {
            char ch = s.charAt(i);
            int loc = s.substring(i+1).lastIndexOf(""+ch);
            if(loc > -1) {
                if(max < loc)
                    max = loc;
            }
        }
        return max;
    }
}
