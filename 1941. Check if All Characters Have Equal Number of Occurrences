class Solution {
    public boolean areOccurrencesEqual(String s) {
        int[] letters = new int[26];
        int max = 0;

        for(int i=0; i<s.length(); i++) {
            letters[s.charAt(i) - 'a'] ++;

            if(max < letters[s.charAt(i) - 'a'])
                max = letters[s.charAt(i) - 'a'];
        }

        for(int i=0; i<26; i++) {
            if(letters[i] != 0 && letters[i] != max)
                return false;
        }

        return true;
    }
}
