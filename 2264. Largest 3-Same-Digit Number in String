class Solution {
    public String largestGoodInteger(String num) {
        String max = "";
        int d = -1;
        for(int i=0; i<num.length() - 2; i++) {
            if(num.charAt(i) == num.charAt(i+1) && 
                num.charAt(i+1) == num.charAt(i+2)) {
            		
                    int dd = num.charAt(i) - '0';
                    if(max != "" && d < dd) {
                        max = num.substring(i, i+3);
                        d = dd;
                    } else if (max == ""){
                        max = num.substring(i, i+3);
                        d = dd;
                    }
                    i += 2;

                }
        }
        return max;
    }
}
