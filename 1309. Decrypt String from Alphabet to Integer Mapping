class Solution {
    public String freqAlphabets(String s) {
        String result = "";
        char[] vals = s.toCharArray();

        for(int i=0; i<vals.length;) {
            if(i+2 < vals.length && vals[i+2] == '#') {
                String temp = s.substring(i, i+2);
                result += (char)(new Integer(temp) + 96);
                i += 3;
            } else {
                result += (char)(vals[i] - 48 + 96);
                i += 1;
            }
        }

        return result;
    }
}
