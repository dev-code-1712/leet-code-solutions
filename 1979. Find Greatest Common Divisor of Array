class Solution {
    public int findGCD(int[] nums) {
        int min = Integer.MAX_VALUE, max = 0;
        for(int num : nums) {
            if(min > num)
                min = num;

            if(max < num)
                max = num;
        }

        int a = min, b = max;
        while(a>0) {
            int temp = b%a;
            b = a;
            a = temp;
        }

        return b;
    }
}
