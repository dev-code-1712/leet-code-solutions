/**
 * Definition for singly-linked list.
 * class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode(int x) {
 *         val = x;
 *         next = null;
 *     }
 * }
 */
public class Solution {
    public ListNode detectCycle(ListNode head) {
        Map<String, ListNode> map = new HashMap();
        ListNode temp = head;
        while(temp != null) {
            String str = String.valueOf(temp);
            if(map.containsKey(str)) {
                return map.get(str);
            } else {
                map.put(str, temp);
            }
            temp = temp.next;
        }
        return null;
    }
}
