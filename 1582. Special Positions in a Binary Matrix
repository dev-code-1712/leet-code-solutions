class Solution {
    public int numSpecial(int[][] mat) {
        int count = 0;
        int r = mat.length, c = mat[0].length;

        for(int i=0; i<r; i++) {
            for(int j=0; j<c; j++) {
                if(mat[i][j] == 1) {

                    boolean flag = false;
                    for(int x=0; x<r; x++) {

                        if(x != i && mat[x][j] == 1) {
                            flag = true;
                            break;
                        }
                    }
                    if(!flag) {
                        for(int y=0; y<c; y++) {

                            if(y != j && mat[i][y] == 1) {
                                flag = true;
                                break;
                            }
                        }  
                    }
                    if(!flag)
                        count ++;
                }
            }
        }
        return count;
    }
}
