class Solution {
    public int maxProduct(int n) {
        int max = 0;
        List<Integer> list = new ArrayList();
        while(n>0) {
            list.add(n%10);
            n/=10;
        }
        for(int i=0; i<list.size()-1; i++) {
            for(int j=i+1; j<list.size(); j++) {
                int x = list.get(i) * list.get(j);
                if(max < x)
                    max = x;
            }
        }
        return max;
    }
}
