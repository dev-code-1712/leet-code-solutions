class Solution {
    public int dominantIndex(int[] nums) {
        int fmax = -1, smax = -1;
        for(int i=0; i<nums.length; i++) {
            if(fmax == -1) {
                fmax = i;
            } else if(fmax != -1 && smax == -1) {
                if(nums[fmax] < nums[i]) {
                    smax = fmax;
                    fmax = i;
                } else {
                    smax = i;
                }
            } else {
                if(nums[fmax] < nums[i]) {
                    smax = fmax;
                    fmax = i;
                } else if(nums[smax] < nums[i]) {
                    smax = i;
                }
            }
        }
        
        //System.out.println(fmax +" "+smax);
        
        if(nums[fmax] / 2 >= nums[smax])
            return fmax;
        else
            return -1;
    }
}
