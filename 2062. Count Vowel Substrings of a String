class Solution {
    boolean is5VowelString(String str) {
        int a=0, e=0, i=0, o=0, u=0, other = 0;
        for(int x=0; x<str.length(); x++) {
            char ch = str.charAt(x);
            switch(ch) {
                case 'a' : a++; break;
                case 'e' : e++; break;
                case 'i' : i++; break;
                case 'o' : o++; break;
                case 'u' : u++; break;
                default : other ++;
            }
        }
        if(other == 0 && a > 0 && e > 0 && i > 0 && o > 0 && u > 0)
            return true;
        else
            return false;
    }
    public int countVowelSubstrings(String word) {

        int len = word.length();
        if(len < 5)
            return 0;

        int count = 0;
        for(int i=0; i<len; i++) {
            for(int j=i+5; j<=len; j++) {
                String str = word.substring(i, j);
                boolean isVowelStr = is5VowelString(str);
                //System.out.println(str +" "+isVowelStr);
                if(isVowelStr) {
                    count ++;
                }
            }
        }
        return count;
    }
}
