class Solution {
    public String toHex(int num) {
        if(num == 0)
            return "0";

        StringBuilder str = new StringBuilder();
        int count = 1;
        while(count <= 32) {
            str.append(num & 1);
            num >>= 1;
            count++;
        }
        String hexa = str.reverse().toString();
        //System.out.println(hexa);
        boolean flag = true;
        String result = "";
        for(int i=0; i<32; i+= 4) {
            int val = Integer.valueOf(hexa.substring(i,i+4), 2);
            if(val == 0 && flag)
                continue;

            if(val != 0 && flag == true)
                flag = false;
            
            if(val < 10)
                result += val;
            else
                result += (char)(87+val);
        }

        return result;
    }
}
