class Solution {
    public List<Integer> findDisappearedNumbers(int[] nums) {
        List<Integer> list = new ArrayList();
        int[] vals = new int[nums.length];
        for (int i=0; i<nums.length; i++) {
            vals[nums[i]-1] ++;
        }
        for(int i=0; i < vals.length; i++) {
            if(vals[i] == 0)
                list.add(i+1);
        }
        return list;
    }
}
