class Solution {

    public int maxDepth(Node root) {
        
        if(root == null)
            return 0;
        else if(root.children.size() == 0)
            return 1;
        else {
            List<Integer> list = new ArrayList<>();
            for(Node child : root.children) {
                list.add(maxDepth(child));
            }
            //System.out.println(root.val +" "+list);
            int max = 0;
            for(int val : list) {
                if(max < val)
                    max = val;
            }
            return 1 + max;
        }
        
    }
}
