class Solution {
    public int sumDivisibleByK(int[] nums, int k) {
        Map<Integer, Integer> map = new HashMap<>();
        int sum = 0;
        for(int val : nums){
            map.put(val, map.getOrDefault(val, 0)+1);
        }
        for(int key : map.keySet()) {
            int freq = map.get(key);
            if(freq % k == 0) {
                sum += key * freq;
            }
        }
        return sum;
    }
}
