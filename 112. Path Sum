/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public boolean hasPathSum(TreeNode root, int targetSum) {
        if(root == null)
            return false;
        
        return traverse(root, targetSum);
    }

    private boolean traverse(TreeNode tree, int target) {
        if(tree == null)
            return false;
        
        //System.out.println(tree.val +" -- "+target);
        if(tree.left == null && tree.right == null) {
            if(tree.val == target)
                return true;
            else
                return false;
        }
        
        return traverse(tree.left, target - tree.val) ||
            traverse(tree.right, target - tree.val);

    }
}
