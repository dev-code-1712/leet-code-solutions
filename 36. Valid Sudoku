class Solution {
    public boolean isValidSudoku(char[][] board) {
        Set<Integer> set = new HashSet<>();

        // rule 1 check
        for(int i=0; i<9; i++) {
            for(int j=0; j<9; j++) {
                if(board[i][j] != '.') {
                    Integer val = Integer.valueOf(board[i][j]);
                    if(set.contains(val))
                        return false;
                    
                    set.add(val);
                }
            }
            set.clear();
        }
        set.clear();

        // rule 2 check
        for(int i=0; i<9; i++) {
            for(int j=0; j<9; j++) {
                if(board[j][i] != '.') {
                    Integer val = Integer.valueOf(board[j][i]);
                    if(set.contains(val))
                        return false;
                    
                    set.add(val);
                }
            }
            set.clear();
        }
        set.clear();

        // rule 3 check
        for(int i=0; i<9; i +=3) {
            for(int j=0; j<9; j +=3) {
                set.clear();
                //System.out.println(i+" "+j);
                for(int x=i; x < i+3; x++) {
                    for(int y=j; y < j+3; y++) {
                        if(board[x][y] != '.') {
                            Integer val = Integer.valueOf(board[x][y]);
                            if(set.contains(val))
                                return false;
                            
                            set.add(val);
                        }
                    }
                }
                
            }
        }

        return true;
    }
}
