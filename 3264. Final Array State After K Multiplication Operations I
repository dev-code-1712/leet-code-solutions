class Solution {
    public int[] getFinalState(int[] nums, int k, int multiplier) {
        
        for(int i=1; i<=k; i++) {
            int min = Integer.MAX_VALUE, pos = -1;
            for(int j=0; j<nums.length; j++) {
                if(min > nums[j]) {
                    min = nums[j];
                    pos = j;
                }
            }
            
            if(pos != -1)
                nums[pos] *= multiplier;

        }
        return nums;
    }
}
