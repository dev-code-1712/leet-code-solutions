class Solution {
    public int alternateDigitSum(int n) {
        String str = ""+n;
        int sum = 0;
        for(int i=0; i<str.length(); i++) {
            int val = str.charAt(i) - '0';
            if(i%2 == 0)
                sum += val;
            else
                sum += -val;
        }
        return sum;
    }
}
