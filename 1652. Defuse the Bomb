class Solution {
    public int[] decrypt(int[] code, int k) {
        int[] result = new int[code.length];
        if(k != 0) {
        	boolean flag = false;
        	int steps = k < 0 ? -k : k;

            for(int i=0; i<code.length; i++) {
                int loc = i, sum = 0;
                flag = false;
                for(int j=0; j<steps; j++) {
                	if(k > 0)
                		loc = (loc + 1) % code.length;
                	else {
                		if(!flag) {
                			if(i == 0)
                    			loc = code.length - 1;
                			else
                				loc = i-1;
                			
                			flag = true;
                		} else {
                			loc --;
                			if(loc == -1)
                				loc = code.length - 1;
                		}
                		
                	}
                	//System.out.println(i+" "+loc);
                    sum += code[loc];
                }
                result[i] = sum;
            }
        }
        
        return result;
    }
}
