/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    int findMax(List<TreeNode> levelvals) {
        int max = Integer.MIN_VALUE;
        for(TreeNode node : levelvals) {
            if(max < node.val)
                max = node.val;
        }

        return max;
    }
    
    public List<Integer> largestValues(TreeNode root) {
        List<Integer> result = new ArrayList();
        if(root == null)
            return result;

        List<TreeNode> levelvals = new ArrayList();
        levelvals.add(root);

        do {
            int max = findMax(levelvals);
            result.add(max);
            List<TreeNode> nextlevelvals = new ArrayList();
            for(TreeNode node : levelvals) {
                if(node.left != null)
                    nextlevelvals.add(node.left);

                if(node.right != null)
                    nextlevelvals.add(node.right);
            }
            levelvals = nextlevelvals;
        } while(levelvals.size() > 0);

        return result;
    }
}
