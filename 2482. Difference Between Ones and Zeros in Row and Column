class Solution {
    public int[][] onesMinusZeros(int[][] grid) {
        int rows = grid.length, cols = grid[0].length;
        int[][] result = new int[rows][cols];

        int[][] rowvals = new int[rows][2];
        for(int i=0; i<rows; i++) {
            for(int j=0; j<cols; j++) {
                if(grid[i][j] == 1)
                    rowvals[i][0] ++;
                else
                    rowvals[i][1] ++;
            }
        }

        int[][] colvals = new int[cols][2];
        for(int i=0; i<cols; i++) {
            for(int j=0; j<rows; j++) {
                if(grid[j][i] == 1)
                    colvals[i][0] ++;
                else
                    colvals[i][1] ++;
            }
        }

        for(int i=0; i<rows; i++) {
            for(int j=0; j<cols; j++) {
                result[i][j] = rowvals[i][0] + colvals[j][0] - rowvals[i][1] - colvals[j][1];
            }
        }

        return result;
    }
}
