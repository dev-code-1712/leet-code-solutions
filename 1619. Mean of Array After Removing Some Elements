class Solution {
    public double trimMean(int[] arr) {
        Arrays.sort(arr);
        
        int len = arr.length;
        int spos = (len * 5)/100;
        int epos = len - spos;
        double sum = 0.0;
        for(int i=spos; i<epos; i++)
            sum += arr[i];

        return sum / (epos-spos);    
    }
}
