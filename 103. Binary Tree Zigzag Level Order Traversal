/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public List<List<Integer>> zigzagLevelOrder(TreeNode root) {
        List<List<Integer>> result = new ArrayList();
        if(root == null)
            return result;
        List<Integer> cresult = new ArrayList();

        boolean flag = false;
        List<TreeNode> list2 = null;
        
        List<TreeNode> list = new ArrayList();
        list.add(root);
        do {
            
            list2 = new ArrayList();
            for(TreeNode node : list) {
                cresult.add(node.val);

                if(node.left != null)
                    list2.add(node.left);
                    
                if(node.right != null)
                    list2.add(node.right);
  
            }

            if(flag) {
                Collections.reverse(cresult);    
            }
            flag = !flag;
            result.add(cresult);
            cresult = new ArrayList();
            list = new ArrayList(list2);
        } while(list.size() > 0);

        return result;
    }
}
