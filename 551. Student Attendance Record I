class Solution {
    public boolean checkRecord(String s) {
        boolean cont = false, award = true;
        int a = 0, l = 0, cl = 0;
        for(char c : s.toCharArray()) {
            if(c == 'P') {
                cl = 0;
                cont = false;
                continue;
            }
            else if(c == 'A') {
                cl = 0;
                cont = false;

                a++;
                if(a > 1)
                    return false;
            } else if(c == 'L') {
                cl++;
                if(cont && cl >= 3) {
                    return false;
                } else {
                    cont = true;
                }
            }

        }

        return award;
    }
}
