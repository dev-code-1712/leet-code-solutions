class Solution {
    public int totalWaviness(int num1, int num2) {
        int count = 0;
        for(int i=num1; i<=num2; i++) {
            if(i >= 100) {
                String str = ""+i;
                for(int j=1; j<str.length()-1; j++) {
                    if( (str.charAt(j-1)-'0' < str.charAt(j)-'0' && 
                        str.charAt(j)-'0' > str.charAt(j+1)-'0') ||
                        (str.charAt(j-1)-'0' > str.charAt(j)-'0' && 
                        str.charAt(j)-'0' < str.charAt(j+1)-'0') )

                            count++;
                }
            }
            
        }
        return count;
    }
}
