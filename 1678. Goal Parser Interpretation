class Solution {
    public String interpret(String command) {
        StringBuilder result = new StringBuilder();
        int len = command.length();
        for(int i=0; i<len; i++) {
            if(command.charAt(i) == 'G') {
                result.append("G");
            } else if(i+1 < len && command.substring(i, i+2).equals("()")) {
                result.append("o");
                i+= 1;
            } else if(i+3 < len && command.substring(i, i+4).equals("(al)")) {
                result.append("al");
                i+= 3;
            }
        }

        return result.toString();
    }
}
