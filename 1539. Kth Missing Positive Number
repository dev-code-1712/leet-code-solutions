class Solution {
    public int findKthPositive(int[] arr, int k) {
        List<Integer> list = new ArrayList<>();
        for(int i=0; i<arr.length; i++) {
            list.add(arr[i]);
        }
        
        List<Integer> list2 = new ArrayList<>();
        for(int i=1; i<=1000; i++) {
            if(!list.contains(i))
                list2.add(i);
        }

        if(k < list2.size())
            return list2.get(k-1);
        else {
            if(list2.size() == 0)
                return list.get(list.size() - 1) + k;
            else {
                int diff = 0;
                if(list2.get(list2.size() - 1) < list.get(list.size() - 1)) 
                    diff = list.get(list.size() - 1) - list2.get(list2.size() - 1);
                
                return list2.get(list2.size() - 1) + (k - list2.size()) + diff;
            }
                
        }
            
    }
}
