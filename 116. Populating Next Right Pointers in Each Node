class Solution {
    public Node connect(Node root) {
        if(root == null)
            return null;
        
        Node temp = root;
        List<Node> list = new ArrayList();
        List<Node> tlist = new ArrayList();
        list.add(temp);
        while(list.size() > 0) {
            for(int i=0; i<list.size(); i++) {

                if(list.get(i).left != null)
                    tlist.add(list.get(i).left);
                
                if(list.get(i).right != null)
                    tlist.add(list.get(i).right);
                
                if((i+1) < list.size())
                    list.get(i).next = list.get(i+1);
            }
            list.clear();
            list.addAll(tlist);
            tlist.clear();
        }

        return temp;
    }
}
