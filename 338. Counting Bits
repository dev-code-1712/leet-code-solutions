class Solution {
    public int[] countBits(int n) {
        int[] bits = new int[n+1];
        for(int i=1; i<=n; i++) {
            int temp = i;
            while(temp > 0) {
                if(temp % 2 == 1)
                    bits[i]++;
                temp >>= 1;
            }
        }
        return bits;
    }
}
