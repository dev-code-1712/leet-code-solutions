class Solution {
    public List<Integer> selfDividingNumbers(int left, int right) {
        List<Integer> result = new ArrayList();
        for(int num=left; num<=right; num++) {
            int temp = num;
            while(temp > 0) {
                int n = temp % 10;
                if(n == 0 || num % n != 0)
                    break;
                
                temp = temp / 10;                 
            }
            if(temp <= 0)
                result.add(num);
        }
        //System.out.println(result);
        return result;
    }
}
