class Solution {
    public int majorityElement(int[] nums) {
        Map<Integer, Integer> map = new HashMap<>();
        int major = 0;
        int big = 0;
        for(int i:nums) {
            int key = i;
            int val = map.get(i) == null ? 0 : map.get(i);

            if(val == 0)
                val = 1;
            else
                val ++;

            if(val > big) {
                big = val;
                major = i;
            }

            map.put(i, val);
        }
        return major;
    }
}
