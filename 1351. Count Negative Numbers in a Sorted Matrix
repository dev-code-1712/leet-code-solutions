class Solution {
    public int countNegatives(int[][] grid) {
        int sum = 0;
        for(int i=0; i<grid.length; i++) {
            int j=0, count = 0;
            for(;j<grid[0].length; j++) {
                if(grid[i][j] < 0)
                    break;

                count++;
            }
            sum += grid[0].length - count;
        }


        return sum;
    }
}
