class Solution {
    public int countValidPrefixes(String s) {
        int zeros = 0, ones = 0, count = 0;
        for(int i=0; i<s.length(); i++) {
            if(s.charAt(i) == '0')
                zeros ++;
            else if(s.charAt(i) == '1')
                ones ++;
            
            if(zeros == ones-1 || zeros == ones || zeros == ones + 1)
                count ++;
        }
        return count;
    }
}
