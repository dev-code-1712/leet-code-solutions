class Solution {
    public int minDeletions(int[] nums) {
        int count = 0;
        for(int i=0; i<nums.length-1; i++) {
            if(nums[i] == nums[i+1]) {
                count ++;

                int j=i+1;
                while(j<nums.length-1 && nums[j] == nums[j+1]) {
                    count ++;
                    j++;
                }
                i = j;
            }
        }
        return count;
    }
}
