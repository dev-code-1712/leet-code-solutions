class Solution {
    public double averageWaitingTime(int[][] customers) {
        double waitsum = 0;
        int start = 0, complete = 0;
        
        for(int i=0; i<customers.length; i++) {

            start = customers[i][0];
            if(i == 0 || complete <= start)
                complete = start + customers[i][1];
            else
                complete = complete + customers[i][1];

            waitsum += complete - start;

        }
        
        return waitsum / customers.length;
    }
}
