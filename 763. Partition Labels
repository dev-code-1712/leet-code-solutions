class Solution {
    public List<Integer> partitionLabels(String s) {
        int len = s.length();
        List<Integer> list = new ArrayList();
        if(len == 1) {
            list.add(1);
            return list;
        }

        Set<Character> set = new HashSet();
        set.add(s.charAt(0));
        boolean flag = false;
        int partloc = 0;
        for(int i=1; i<len; i++) {
            String str = s.substring(i);
            //System.out.println(set +" "+str);
            for(char ch:set) {
                if(str.indexOf(ch) != -1) {
                    flag = true;
                    break;
                }  
            }
            if(!flag) {
                list.add(i- partloc);
                partloc = i;
                set = new HashSet();
            } else {
                
                flag = false;
            }
            set.add(s.charAt(i));
        }
        list.add(len - partloc);
        //System.out.println(list);
        return list;
    }
}
