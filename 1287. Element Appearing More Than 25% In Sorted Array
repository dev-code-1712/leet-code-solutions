class Solution {
    public int findSpecialInteger(int[] arr) {
        int val = -1;
        for(int i=0; i<arr.length; i++) {
            int count = 1;
            if(i<arr.length-1 && arr[i] == arr[i+1]) {
                for(int j=i+1; j<arr.length; j++) {
                    if(arr[i] != arr[j])
                        break;
                    count ++;
                }
                i += count-1;
            }
            
            if((0.0 + count) / arr.length > 0.25) {
                val = arr[i];
                break;
            }
        }
        return val; 
    }
}
