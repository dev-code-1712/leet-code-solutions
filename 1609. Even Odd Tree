/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public boolean isEvenOddTree(TreeNode root) {
        List<TreeNode> list = new ArrayList();
        list.add(root);
        int count = 0;
        TreeNode node = root;
        do {
            if(list.size() == 1) {

                if(count % 2 == 0 && list.get(0).val % 2 != 1)
                    return false;

                if(count % 2 == 1 && list.get(0).val % 2 != 0)
                    return false;
            } else {
                for(int i=0; i<list.size() - 1; i++) {

                    if(count % 2 == 0) {
                        if(list.get(i).val % 2 != 1 || list.get(i+1).val % 2 != 1
                             || list.get(i).val >= list.get(i+1).val)
                            return false;
                    } else {
                        if(list.get(i).val % 2 != 0 || list.get(i+1).val % 2 != 0
                            || list.get(i).val <= list.get(i+1).val)
                            return false;
                    }
                }
            }
            
            List<TreeNode> templist = new ArrayList();
            for(int i=0; i<list.size(); i++) {
                if(list.get(i).left != null)
                    templist.add(list.get(i).left);
                
                if(list.get(i).right != null)
                    templist.add(list.get(i).right);
            }
            list.clear();
            list = templist;
            count ++;
        } while(list.size() > 0);

        return true;
    }
}
