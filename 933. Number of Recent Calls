class RecentCounter {
    List<Integer> list = null;
    int[] range = null;
    public RecentCounter() {
        list = new ArrayList<>();
        range = new int[2];
    }
    
    public int ping(int t) {
        range[1] = t;
        range[0] = t-3000;
        list.add(t);
        int count = 0;
        for(int val : list) {
            if(range[0] <= val && val <= range[1])
                count ++;
        }
        return count;
    }
}

