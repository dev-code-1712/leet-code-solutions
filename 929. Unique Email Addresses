class Solution {
    public int numUniqueEmails(String[] emails) {
        Set<String> set = new HashSet();
        for(String str:emails) {
            String[] parts = str.split("@");

            if(parts[1].length() <= 4 || !parts[1].endsWith(".com"))
                continue;
            
            StringBuilder localname = new StringBuilder();
            for(int i=0; i<parts[0].length(); i++) {
                if(parts[0].charAt(i) == '+')
                    break;
                
                if(parts[0].charAt(i) == '.')
                    continue;
                
                localname.append(parts[0].charAt(i));
            }
            set.add(localname.toString()+"@"+parts[1]);
        }

        return set.size();
    }
}
