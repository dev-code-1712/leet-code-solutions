class Solution {
    public int[] maxProductPair(int[] nums, int target) {
        int result[] = {-1, -1};
        int max = 0;
        boolean flag = false;
        for(int i=0; i<nums.length; i++) {
            for(int j=0; j<nums.length; j++) {
                if(nums[i] > nums[j] && nums[i]+nums[j] == target) {
                    if(!flag) {
                        result[0] = i;
                        result[1] = j;
                        max = nums[i] * nums[j];
                        flag = true;
                    } else {
                        int newval = nums[i] * nums[j];
                        if(max < newval) {
                            max = newval;
                            result[0] = i;
                            result[1] = j;
                        }
                    }
                }
            }
        }

        return result; 
    }
}
