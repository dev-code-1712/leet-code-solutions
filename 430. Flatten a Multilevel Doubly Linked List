/*
// Definition for a Node.
class Node {
    public int val;
    public Node prev;
    public Node next;
    public Node child;
};
*/

class Solution {
    public Node flatten(Node head) {
        if(head == null)
            return null;
        
        List<Integer> list = new ArrayList<>();
        dfs(head, list);
        Node flist = makelist(list);
        return flist;
    }

    void dfs(Node node, List<Integer> list) {
        if(node == null)
            return;
        
        list.add(node.val);
        
        if(node.child != null) {
            dfs(node.child, list);
        }

        dfs(node.next, list);

    }

    Node makelist(List<Integer> list) {
        Node head = null, tail = null;
        for(int val : list) {
            if(head == null) {
                head = tail = new Node(val);
            } else {
                Node node = new Node(val);
                tail.next = node;
                node.prev = tail;
                tail = node;
            }
        }
        return head;
    }
}
