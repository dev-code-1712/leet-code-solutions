class Solution {
    public List<String> summaryRanges(int[] nums) {
        List<String> list = new ArrayList();
        if(nums.length == 0)
            return list;
        
        int prev = nums[0];
        for(int i=1; i<nums.length; i++) {
            if(nums[i-1] + 1 == nums[i])
                continue;
            
            if(prev != nums[i-1])
                list.add(""+prev+"->"+nums[i-1]);
            else 
                list.add(""+prev);
            
            prev = nums[i];
        }

        if(prev != nums[nums.length-1])
            list.add(""+prev+"->"+nums[nums.length-1]);
        else 
            list.add(""+prev);

        return list;
    }
}
