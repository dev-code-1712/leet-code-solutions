class Solution {
    public String reformatNumber(String number) {
        StringBuilder builder = new StringBuilder();
        for(char ch:number.toCharArray()) {
            if(ch != ' ' && ch != '-')
                builder.append(ch);
        }
        number = builder.toString();
        int len = number.length(), count = 0;
        builder.setLength(0);

        for(int i=0; i<len; i+=3) {
            int pending = len - i;
            if(pending > 4) {
                builder.append(number.substring(i, i+3));
                builder.append("-");
            } else {
                if(pending == 2 || pending == 3) {
                    builder.append(number.substring(i));
                } else if(pending == 4) {
                    builder.append(number.substring(i, i+2));
                    builder.append("-");
                    builder.append(number.substring(i+2));
                }
                break;
            }
        }

        return builder.toString();
    }
}
