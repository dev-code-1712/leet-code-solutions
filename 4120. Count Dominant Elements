class Solution {
    public int countDominantElements(int[] nums) {
        int count = 0, len = nums.length;
        if(len == 1)
            count = 1;
        else {
            for(int i=0; i<len; i++) {
                if(i == 0) {
                    if(nums[0] >= nums[1])
                        count = 1;
                } else if(i == len-1) {
                    if(nums[len-2] <= nums[len-1])
                        count ++;
                } else {
                    float avg = (nums[i-1] + nums[i+1]) / 2.0f;
                    if((nums[i]+0.0f) >= avg)
                        count ++;
                }
            }
        }
        return count;
    }
}
