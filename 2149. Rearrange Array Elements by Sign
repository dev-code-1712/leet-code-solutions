class Solution {
    public int[] rearrangeArray(int[] nums) {
        List<Integer> plist = new ArrayList();
        List<Integer> nlist = new ArrayList();
        
        for(int i=0; i<nums.length; i++) {
            if(nums[i] > 0) 
                plist.add(nums[i]);
            else
                nlist.add(nums[i]);
        }

        int[] result = new int[nums.length];
        int j=0, k=0;
        for(int i=0; i<nums.length; i++) {
            if(i%2 == 0)
                result[i] = plist.get(j++);
            else 
                result[i] = nlist.get(k++);
        }
        return result;
    }
}
