class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {
        if(n == 0)
            return;
        if(m == 0) {
            int i=0;
            while(i<nums2.length) {
                nums1[i] = nums2[i];
                i++;
            }
        }
        if(n==1) {
            nums1[nums1.length-1] = nums2[0];
        }
        for(int i=0; i<n; i++) {
            int j=0;
            while(j < m && nums2[i] > nums1[j])
                j++;
            if(j == m) {
                nums1[j] = nums2[i];
                m++;
            } else {
                int k=m;
                while(k>j) {
                    nums1[k] = nums1[k-1];
                    k--;
                }
                nums1[k] = nums2[i];
                m++;
            }
        }
        
   }
}
