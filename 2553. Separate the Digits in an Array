class Solution {
    void getDigits(int num, List<Integer> digits) {
        if(num > 0) {
            int d = num % 10;
            getDigits(num/10, digits);
            digits.add(d);
        }
    }
    public int[] separateDigits(int[] nums) {
        List<Integer> list = new ArrayList();
        List<Integer> digits = new ArrayList();
        for(int num : nums) {
            getDigits(num, digits);
            list.addAll(digits);
            digits.clear();
        }
        int[] result = new int[list.size()];
        int i=0;
        for(int num : list) {
            result[i++] = num;
        }
        return result;
    }
}
