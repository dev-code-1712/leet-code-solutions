class Solution {
    public boolean isIsomorphic(String s, String t) {
        if(s.length() != t.length())
            return false;

        boolean result = true;
        Map<Character, Character> map = new HashMap<>();
        Map<Character, Character> map2 = new HashMap<>();

        char[] vals = s.toCharArray();
        char[] vals2 = t.toCharArray();

        for(int i=0; i<vals.length; i++) {
            char c = vals[i];
            char c2 = vals2[i];

            if(map.get(c) != null && map.get(c) != c2) 
                return false;
            else
                map.put(c, c2);

            if(map2.get(c2) != null && map2.get(c2) != c)
                return false;
            else 
                map2.put(c2, c);
        }

        return result;
    }
}
