/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    int max = 0, val = -1;
    public int findBottomLeftValue(TreeNode root) {
    
        findBottomMostValue(root, 1);
        return val;
    }
    void findBottomMostValue(TreeNode node, int count) {
        if(node == null)
            return;
        //System.out.println(node.val +" : "+max +" : "+count);
        if(max < count) {
            max = count;
            val = node.val;
        }
        findBottomMostValue(node.left, count+1);
        findBottomMostValue(node.right, count+1);
    }
}
