class Solution {
    public int minElement(int[] nums) {
        int min = 10001;
        for(int val : nums) {
            int sum = 0;
            while(val > 0) {
                sum += val % 10;
                val /= 10;
            }
            if(sum < min)
                min = sum;
        }

        return min;
    }
}
