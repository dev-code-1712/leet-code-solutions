class Solution {
    public int nearestDrone(int[][] drones, int[] target) {
        int n = drones.length;
        int min = Integer.MAX_VALUE;
        int loc = -1;

        for(int i=0; i<n; i++) {
            int a = Math.abs(drones[i][0] - target[0]);
            int b = Math.abs(drones[i][1] - target[1]);
            int d = a+b;

            if(d <= drones[i][2]  && d < min) {
                min = d;
                loc = i;
            }
        }
        
        return loc;
    }
}
