class Solution {
    public int titleToNumber(String columnTitle) {
        int len = columnTitle.length();

        char[] vals = columnTitle.toCharArray();
        int sum = 0, square = 1;
        for(int i=len-1; i >= 0; i--) {
            int value = vals[i] - 64;
            if(i == len - 1)
                square = 1;
            else
                square = square * 26;
            sum = sum + value * square;
        }
        return sum;
    }
}
