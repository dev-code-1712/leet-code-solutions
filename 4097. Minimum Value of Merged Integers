class Solution {
    public int minMergedInteger(int[] nums) {
        int min = Integer.MAX_VALUE;
        for(int i=0; i<nums.length; i+=2) {
            String sval = nums[i]+""+nums[i+1];
            int ival = Integer.valueOf(sval);
            if(min > ival)
                min = ival;
        }
        return min;
    }
}
