class Solution {
    public int totalMoney(int n) {
        int sum = 0, starts = 1;
        while(n > 0) {
        	int end = n > 7 ? 7: n;
            for(int i=starts; i<= starts + end - 1; i++)
                sum += i;

            n -= 7;
            starts ++;
        }
        return sum;
    }
}
