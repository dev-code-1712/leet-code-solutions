class Solution {
    public boolean isCircularSentence(String sentence) {
        String[] vals = sentence.split(" ");

        if(vals.length == 1 && vals[0].charAt(vals[0].length()-1) != vals[0].charAt(0))
            return false;

        for(int i=0; i<vals.length-1; i++) {
            if(vals[i].charAt(vals[i].length()-1) != vals[i+1].charAt(0))
                return false;
        }

        if(vals[vals.length - 1].charAt(vals[vals.length - 1].length()-1) != vals[0].charAt(0))
            return false;

        return true;
    }
}
