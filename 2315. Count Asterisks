class Solution {
    public int countAsterisks(String s) {
        String[] words = s.split("\\|");

        int sum = 0;
        for(int i=0; i<words.length; i+=2) {
            String str = words[i];
            int count = 0;
            for(int j=0; j<str.length(); j++) {
                if(str.charAt(j) == '*')
                    count ++;
            }

            sum += count;
        }

        return sum;
    }
}
