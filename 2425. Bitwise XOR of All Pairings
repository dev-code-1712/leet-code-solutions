class Solution {
    public int xorAllNums(int[] nums1, int[] nums2) {
        int sum = 0;
        if(Arrays.equals(nums1, nums2))
            return 0;
        for(int val : nums1) {
            for(int val2 : nums2) {
                int xor = val ^ val2;
                sum ^= xor;
            }
        }
        return sum;
    }
}
