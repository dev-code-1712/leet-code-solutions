class Solution {
    public int maximum69Number (int num) {
        String str = ""+num;
        char[] vals = str.toCharArray();

        for(int i=0; i<vals.length; i++) {
            if(vals[i] == '6') {
                vals[i] = '9';
                break;
            }
        }

        str = String.valueOf(vals);
        System.out.println(str);
        return Integer.valueOf(str);  
    }
}
