class Solution {
    public int finalValueAfterOperations(String[] operations) {
        int count = 0;
        for(int i=0; i<operations.length; i++) {
            if("++X".equals(operations[i]) || "X++".equals(operations[i]))
                count ++;
            else if("--X".equals(operations[i]) || "X--".equals(operations[i]))
                count --;
        }
        return count;
    }
}
