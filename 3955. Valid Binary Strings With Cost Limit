class Solution {

    String getBS(int num, int len) {
        String str = "";
        while(num > 0) {
            str = (num % 2)+str;
            num /= 2;
        }
        int diff = len - str.length();
        for(int i=0; i < diff; i++) {
            str = "0"+str;
        }
        return str;
    }

    public List<String> generateValidStrings(int n, int k) {
        List<String> list = new ArrayList();
        int max = (int)(Math.pow(2, n));

        for(int i=0; i<max; i++) {
            String str = getBS(i, n);

            boolean flag = false;
            int sum = 0;
            for(int j=0; j<n; j++) {
                if(str.charAt(j) == '1')
                    sum += j;
                if(j < n-1 && str.charAt(j) == '1' && str.charAt(j+1) == '1') {
                    flag = true;
                    break;
                }
            }
            if(!flag && sum <= k)
                list.add(str);
        }

        return list;
    }
}
