class Solution {
    public String[] uncommonFromSentences(String s1, String s2) {
        Set<String> set = new HashSet();
        Set<String> dups = new HashSet();

        for(String str : s1.split(" ")) {
            if(set.contains(str))
                dups.add(str);
            else 
                set.add(str);
        }

        for(String str : s2.split(" ")) {
            if(set.contains(str)) 
                dups.add(str);
            else
                set.add(str);
        }

        set.removeAll(dups);

        String[] result = new String[set.size()];
        int i=0;
        for(String str:set) {
            result[i++] = str;
        }

        return result;
    }
}
