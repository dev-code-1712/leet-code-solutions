class Solution {
    public String replaceDigits(String s) {
        char[] chars = s.toCharArray();
        for(int i=0; i<s.length(); i+=2) {
            char ch = s.charAt(i);
            if(i+1 < s.length()) {
                int d = s.charAt(i+1) - '0';
                chars[i+1] = (char) ('a'+ (ch-'a' + d) % 26);
            }
        }

        return String.valueOf(chars);
    }
}
