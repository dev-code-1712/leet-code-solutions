class Solution {
    public String reformat(String s) {
        
        List<Character> letters = new ArrayList();
        List<Character> digits = new ArrayList();

        for(int i=0; i<s.length(); i++) {
            if(s.charAt(i) >= 'a' && s.charAt(i) <= 'z')
                letters.add(s.charAt(i));
            else 
                digits.add(s.charAt(i));
        }

        StringBuilder str = new StringBuilder();
        String result = "";
        if(letters.size() == digits.size()) {
            for(int i=0; i< letters.size(); i++) {
                str.append(letters.get(i))
                    .append(digits.get(i));

            }
            result = str.toString();
        } else if(letters.size() == digits.size() - 1) {
            int i = 0;
            while(i < letters.size() && i < digits.size()) {
                str.append(digits.get(i))
                    .append(letters.get(i));
                i++;
            }
            str.append(digits.get(i));
            result = str.toString();
        } else if(letters.size() - 1 == digits.size()) {
            int i = 0;
            while(i < letters.size() && i < digits.size()) {
                str.append(letters.get(i))
                    .append(digits.get(i));
                i++;
            }
            str.append(letters.get(i));
           result = str.toString(); 
        } else {
            result = "";
        }

        return result;
    }
}
