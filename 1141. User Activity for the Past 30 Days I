select a.activity_date as day, count(*) as active_users
from 
    (select activity_date, count(distinct user_id)
    from activity
    where activity_date > DATE_ADD('2019-07-27', INTERVAL -30 DAY)
    and activity_date <= '2019-07-27'
    group by activity_date, user_id) a
group by a.activity_date
