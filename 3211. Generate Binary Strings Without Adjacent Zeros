class Solution {
    public List<String> validStrings(int n) {
        List<String> list = new ArrayList();
        list.add("0");
        list.add("1");

        List<String> tlist = new ArrayList();
        for(int i=1; i<n; i++) {
            for(String str:list) {
                for(int j=0; j<2; j++) {
                    tlist.add(str + j);
                }
            }
            list = filter(tlist);
            tlist.clear();
        }
        
        return list;   
    }

    List<String> filter(List<String> tlist) {
        List<String> list = new ArrayList();
        for(String word:tlist) {
            boolean flag = false;
            for(int i=0; i<word.length()-1; i++) {
                if(word.charAt(i) == '0' && word.charAt(i+1) == '0') {
                    flag = true;
                    break;
                }
            }
            if(!flag)
                list.add(word);
        }
        return list;
    }
}
