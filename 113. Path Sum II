/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public List<List<Integer>> pathSum(TreeNode root, int targetSum) {
        List<List<Integer>> list = new ArrayList();
        if(root != null)
            findPathSum(root, targetSum, list, 0, "");
        return list;
    }

    void findPathSum(TreeNode node, int target, List<List<Integer>> list, int total, String path) {

        int ctotal = total + node.val;
        String cpath = path!=""? path+":"+node.val : ""+node.val;
        
        if(ctotal == target && node.left == null && node.right == null) {
            //System.out.println(ctotal +" "+cpath);

            List<Integer> clist = new ArrayList();
            for(String str : cpath.split(":"))
                clist.add(Integer.valueOf(str));
            
            list.add(clist);
        } 

        if(node.left != null)
            findPathSum(node.left, target, list, ctotal, cpath);
        
        if(node.right != null)
            findPathSum(node.right, target, list, ctotal, cpath);
    }
}
