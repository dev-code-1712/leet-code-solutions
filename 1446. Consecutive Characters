class Solution {
    public int maxPower(String s) {
        int max = 1;
        for(int i=0; i<s.length()-1; i++) {
            if(s.charAt(i) == s.charAt(i+1)) {
                int count = 2;
                for(int j=i+1; j<s.length()-1; j++) {
                    if(s.charAt(j) != s.charAt(j+1)) 
                        break;
                    count ++;
                }

                if(max < count)
                    max = count;

                i += count-1;
            }
        }

        return max;
    }
}
