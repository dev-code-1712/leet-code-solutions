class Solution {
    public int findLucky(int[] arr) {
        Map<Integer, Integer> map = new HashMap();
        for(int num : arr) {
            if(map.containsKey(num)) {
                map.put(num, map.get(num) + 1);
            } else {
                map.put(num, 1);
            }
        }
        int max = 0;
        for(int key : map.keySet()) {
            if(map.get(key) == key) {
                if(max < key)
                    max = key;
            }
        }
        if(max > 0)
            return max;
        else
            return -1;
    }
}
